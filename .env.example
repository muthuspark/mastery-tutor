# Used by the server-side Codex CLI adapter when the process cannot reuse
# the existing Codex login of the current OS user.
CODEX_ACCESS_TOKEN=

# Optional maximum duration of each AI CLI call, in milliseconds (default: 180000).
# Course planning, writing, and quality review each receive their own time limit.
CODEX_TIMEOUT_MS=180000
CLAUDE_TIMEOUT_MS=180000

# Optional model overrides for short interactive practice (otherwise uses chapter/global model).
# CODEX_MODEL_SOCRATIC=
# CLAUDE_MODEL_SOCRATIC=

# Optional local SQLite path. The default will be documented with the DB task.
DATABASE_URL=file:./data/tutor.db
