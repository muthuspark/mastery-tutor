# Used by the server-side Codex CLI adapter when the process cannot reuse
# the existing Codex login of the current OS user.
CODEX_ACCESS_TOKEN=

# Optional maximum duration of each AI provider call, in milliseconds (default: 180000).
# Course planning, writing, and quality review each receive their own time limit.
CODEX_TIMEOUT_MS=180000
CLAUDE_TIMEOUT_MS=180000

# Optional model overrides for short interactive practice (otherwise uses chapter/global model).
# CODEX_MODEL_SOCRATIC=
# CLAUDE_MODEL_SOCRATIC=

# Optional local SQLite path. The default will be documented with the DB task.
DATABASE_URL=file:./data/tutor.db

# DeepSeek API: server-only key, loaded from the repository-root .env file.
# Configure a real value locally; never use NEXT_PUBLIC_ or commit credentials.
DEEPSEEK_API_KEY=
# Optional model and per-call timeout (defaults shown):
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_TIMEOUT_MS=180000
# Optional task model overrides (task > global > default):
# DEEPSEEK_MODEL_SYLLABUS=
# DEEPSEEK_MODEL_CHAPTER=
# DEEPSEEK_MODEL_QUIZ=
# DEEPSEEK_MODEL_GRADING=
# DEEPSEEK_MODEL_REVIEW=
# DEEPSEEK_MODEL_SOCRATIC=
# Socratic falls back to CHAPTER, then global, then deepseek-flash.
# Thinking is disabled. Output limit: 16384 tokens, or 4096 for Socratic.
# Discovery checks configuration only; API usage is paid. Restart after edits.
